{
  "name": "quanlycongno-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Local backend for the debt management app (installed on the customer's machine)",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts serve --data-dir .data",
    "start": "tsx src/main.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
